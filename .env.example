# ================================
# Server Configuration
# ================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ================================
# Single Business Owner Configuration
# (Controls exclusive admin panel authorization & bootstrapping)
# ================================
OWNER_EMAIL=yeswanthagathamudi@gmail.com
OWNER_NAME=Yeswanth Agathamudi
OWNER_INITIAL_PASSWORD=YourSecureOwnerPassword123!
ENFORCE_STRICT_OWNER=true

# ================================
# MongoDB Database
# ================================
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ecommerce?retryWrites=true&w=majority

# ================================
# JWT Authentication Secrets
# Generate using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ================================
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_here
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_here

# ================================
# Redis Cache (Upstash)
# ================================
UPSTASH_REDIS_URL=rediss://:password@region.upstash.io:6379

# ================================
# Media Storage (Cloudinary)
# ================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ================================
# Stripe Payments (INR Currency)
# ================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# ================================
# Transactional Email (Gmail SMTP / Nodemailer)
# Use your Gmail address and 16-character Gmail App Password
# https://myaccount.google.com/apppasswords
# ================================
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
FROM_EMAIL="LuxeStore Atelier" <no-reply@luxestore.in>

# Optional custom SMTP host (if not using default Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password

# ================================
# Security & Rate Limiting Policies
# ================================
AUTH_RATE_LIMIT_MAX_PER_15MIN=100

# ================================
# Razorpay Standard Checkout (INR Currency)
# Obtain test credentials from https://dashboard.razorpay.com/#/app/keys
# Webhook URL: https://yourdomain.com/api/payments/webhook
# Secret configured in webhook settings must match RAZORPAY_WEBHOOK_SECRET
# ================================
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ================================
# Shiprocket Logistics & Serviceability
# ================================
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_PICKUP_PINCODE=110001
SHIPROCKET_CACHE_TTL_SECONDS=1800

